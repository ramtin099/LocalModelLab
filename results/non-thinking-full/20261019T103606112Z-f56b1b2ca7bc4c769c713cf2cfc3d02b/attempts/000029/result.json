  "answer": "Async/await \u062F\u0631 \u0632\u0628\u0627\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0648\u06CC\u0633\u06CC C# \u0628\u0647 \u0645\u0627 \u0627\u0645\u06A9\u0627\u0646 \u0627\u0631\u0627\u0626\u0647 \u06A9\u062F \u0631\u0627 \u0628\u0627\u0632 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u0628\u0647 \u0637\u0648\u0631 \u0645\u0648\u0627\u0632\u06CC \u0627\u062C\u0631\u0627 \u0634\u0648\u062F. \u0627\u06CC\u0646 \u062A\u0627\u0628\u0639 \u0628\u0647 \u0645\u0627 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u06A9\u062F \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u062A\u0637\u0628\u06CC\u0642\u06CC \u0628\u0646\u0648\u06CC\u0633\u06CC\u0645 \u0648 \u0647\u0645\u0632\u0645\u0627\u0646 \u0628\u0647 \u0627\u06CC\u0646 \u062F\u0633\u062A\u0627\u0648\u0631\u062F \u062F\u0633\u062A\u0631\u0633\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u06CC\u0645 \u06A9\u0647 \u06A9\u062F \u062F\u06CC\u06AF\u0631\u06CC \u062F\u0631 \u062D\u0627\u0644 \u0627\u062C\u0631\u0627 \u0628\u0627\u0634\u062F. \u0627\u06CC\u0646 \u062A\u0627\u0628\u0639 \u0628\u0647 \u0645\u0627 \u0627\u0645\u06A9\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u06A9\u062F \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u062A\u0637\u0628\u06CC\u0642\u06CC \u0628\u0646\u0648\u06CC\u0633\u06CC\u0645 \u0648 \u0647\u0645\u0632\u0645\u0627\u0646 \u0628\u0647 \u0627\u06CC\u0646 \u062F\u0633\u062A\u0627\u0648\u0631\u062F \u062F\u0633\u062A\u0631\u0633\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u06CC\u0645 \u06A9\u0647 \u06A9\u062F \u062F\u06CC\u06AF\u0631\u06CC \u062F\u0631 \u062D\u0627\u0644 \u0627\u062C\u0631\u0627 \u0628\u0627\u0634\u062F.\n\n\u0628\u0631\u0627\u06CC \u0645\u062B\u0627\u0644\u060C \u0627\u06CC\u0646\u062C\u0627 \u06CC\u06A9 \u06A9\u062F \u06A9\u0648\u062A\u0627\u0647\u06CC \u062F\u0631 C# \u0627\u0633\u062A \u06A9\u0647 \u0627\u0632 async/await \u0628\u0631\u0627\u06CC \u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC \u0648 CancellationToken \u0628\u0631\u0627\u06CC \u0644\u063A\u0648 \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F:\n\n\u0060\u0060\u0060csharp\nusing System;\nusing System.Net.Http;\nusing System.Threading.Tasks;\n\nclass Program\n{\n    static async Task Main(string[] args)\n    {\n        using (var client = new HttpClient())\n        {\n            // CancellationTokenSource \u0628\u0631\u0627\u06CC \u0644\u063A\u0648 \u062F\u0631\u062E\u0648\u0627\u0633\u062A\n            var cancellationTokenSource = new CancellationTokenSource();\n            var token = cancellationTokenSource.Token;\n\n            try\n            {\n                // \u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC \u0628\u0627 async/await\n                var response = await client.GetAsync(\u0022https://example.com\u0022, token);\n\n                // \u0627\u06AF\u0631 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0627\u0632 \u0637\u0631\u06CC\u0642 CancellationToken \u0644\u063A\u0648 \u0634\u062F\u0647 \u0628\u0627\u0634\u062F\n                if (!token.IsCancellationRequested)\n                {\n                    Console.WriteLine(await response.Content.ReadAsStringAsync());\n                }\n            }\n            catch (OperationCanceledException)\n            {\n                Console.WriteLine(\u0022\u062F\u0631\u062E\u0648\u0627\u0633\u062A \u062F\u0631 \u062D\u0627\u0644 \u0644\u063A\u0648 \u0634\u062F.\u0022);\n            }\n        }\n    }\n}\n\u0060\u0060\u0060\n\n\u062F\u0631 \u0627\u06CC\u0646 \u06A9\u062F\u060C \u0627\u0632 \u0060CancellationTokenSource\u0060 \u0628\u0631\u0627\u06CC \u0627\u06CC\u062C\u0627\u062F \u06CC\u06A9 \u0060CancellationToken\u0060 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u06CC\u0646 \u0060CancellationToken\u0060 \u0628\u0639\u062F\u0627\u064B \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06CC\u06A9 \u067E\u0627\u0631\u0627\u0645\u062A\u0631 \u062F\u0631 \u0060GetAsync\u0060 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u06AF\u0631 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0627\u0632 \u0637\u0631\u06CC\u0642 \u0060CancellationToken\u0060 \u0644\u063A\u0648 \u0634\u062F\u0647 \u0628\u0627\u0634\u062F\u060C \u0060OperationCanceledException\u0060 \u067E\u0631\u062F\u0627\u062E\u062A \u0645\u06CC\u200C\u0634\u0648\u062F.",
