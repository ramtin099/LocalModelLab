  "answer": "async/await \u0648 \u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC \u062F\u0631 \u0633\u06CC\u200C\u0634\u0627\u0631\u067E \u0647\u0631 \u062F\u0648 \u0631\u0648\u0634\u06CC \u0628\u0631\u0627\u06CC \u0627\u0646\u062C\u0627\u0645 \u0639\u0645\u0644\u06CC\u0627\u062A \u0647\u0633\u062A\u0646\u062F\u060C \u0627\u0645\u0627 \u0622\u0646\u200C\u0647\u0627 \u0628\u0647 \u0637\u0648\u0631 \u0645\u062A\u0641\u0627\u0648\u062A \u0639\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F.\n\nasync/await: \u0627\u06CC\u0646 \u0631\u0648\u0634 \u0628\u0647 \u0634\u0645\u0627 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u0639\u0645\u0644\u06CC\u0627\u062A \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u0647\u0645\u0632\u0645\u0627\u0646 \u0627\u062C\u0631\u0627 \u06A9\u0646\u06CC\u062F\u060C \u0627\u0645\u0627 \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646\u062F. \u0628\u0647 \u0639\u0628\u0627\u0631\u062A \u062F\u06CC\u06AF\u0631\u060C \u0627\u06CC\u0646 \u0631\u0648\u0634 \u0628\u0647 \u0634\u0645\u0627 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u062F\u0631 \u062D\u0627\u0644\u06CC \u06A9\u0647 \u06CC\u06A9 \u0639\u0645\u0644\u06CC\u0627\u062A \u062F\u0631 \u062D\u0627\u0644 \u0627\u0646\u062C\u0627\u0645 \u0627\u0633\u062A\u060C \u0628\u0631\u0646\u0627\u0645\u0647 \u0634\u0645\u0627 \u0628\u0647 \u062F\u0646\u0628\u0627\u0644 \u0639\u0645\u0644\u06CC\u0627\u062A \u0628\u0639\u062F\u06CC \u062D\u0631\u06A9\u062A \u06A9\u0646\u062F. \u0627\u06CC\u0646 \u0631\u0648\u0634 \u0628\u0647 \u0634\u0645\u0627 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u06A9\u062F \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u062E\u0648\u0627\u0646\u0627 \u0648 \u0642\u0627\u0628\u0644 \u062A\u0648\u062C\u0647\u200C\u062A\u0631 \u0628\u0646\u0648\u06CC\u0633\u06CC\u062F.\n\n\u0645\u062B\u0627\u0644 \u0633\u0627\u062F\u0647 \u062F\u0631 C#:\n\n\u0060\u0060\u0060csharp\npublic async Task\u003Cint\u003E GetNumberAsync()\n{\n    await Task.Delay(1000); // \u0627\u06CC\u0646 \u0639\u0645\u0644\u06CC\u0627\u062A 1 \u062B\u0627\u0646\u06CC\u0647 \u0637\u0648\u0644 \u0645\u06CC\u200C\u0628\u0631\u062F\n    return 42;\n}\n\u0060\u0060\u0060\n\nCancellationToken: \u0627\u06CC\u0646 \u06A9\u0644\u0627\u0633 \u0627\u0645\u06A9\u0627\u0646 \u0627\u0631\u0627\u0626\u0647 \u06CC\u06A9 \u0631\u0627\u0647\u0628\u0631\u062F \u0628\u0631\u0627\u06CC \u0644\u063A\u0648 \u0639\u0645\u0644\u06CC\u0627\u062A \u0647\u0633\u062A\u0646\u062F. \u0627\u06AF\u0631 \u0639\u0645\u0644\u06CC\u0627\u062A \u0644\u063A\u0648 \u0634\u0648\u062F\u060C CancellationToken \u06CC\u06A9 OperationCanceledException \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F.\n\n\u0645\u062B\u0627\u0644 \u0633\u0627\u062F\u0647 \u062F\u0631 C#:\n\n\u0060\u0060\u0060csharp\npublic async Task\u003Cint\u003E GetNumberAsync(CancellationToken token)\n{\n    for (int i = 0; i \u003C 10; i\u002B\u002B)\n    {\n        if (token.IsCancellationRequested)\n        {\n            throw new OperationCanceledException(token);\n        }\n        await Task.Delay(1000); // \u0627\u06CC\u0646 \u0639\u0645\u0644\u06CC\u0627\u062A 1 \u062B\u0627\u0646\u06CC\u0647 \u0637\u0648\u0644 \u0645\u06CC\u200C\u0628\u0631\u062F\n    }\n    return 42;\n}\n\u0060\u0060\u0060\n\n\u062F\u0631 \u0627\u06CC\u0646 \u0645\u062B\u0627\u0644\u060C \u0627\u06AF\u0631 \u0639\u0645\u0644\u06CC\u0627\u062A \u0644\u063A\u0648 \u0634\u0648\u062F\u060C OperationCanceledException \u0627\u0631\u0627\u0626\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.",
