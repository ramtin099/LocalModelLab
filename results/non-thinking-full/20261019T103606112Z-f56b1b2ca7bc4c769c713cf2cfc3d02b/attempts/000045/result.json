  "answer": "\u062F\u0631 \u0632\u0628\u0627\u0646 **C#**\u060C \u0645\u0641\u0627\u0647\u06CC\u0645 \u0060async\u0060/\u0060await\u0060\u060C **\u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC (Parallelism)** \u0648 **CancellationToken** \u062A\u0641\u0627\u0648\u062A\u200C\u0647\u0627\u06CC \u0628\u0646\u06CC\u0627\u062F\u06CC \u062F\u0627\u0631\u0646\u062F \u06A9\u0647 \u062F\u0631\u06A9 \u0622\u0646\u200C\u0647\u0627 \u0628\u0631\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A \u0635\u062D\u06CC\u062D \u0628\u0631\u0646\u0627\u0645\u0647\u200C\u0646\u0648\u06CC\u0633\u06CC \u062D\u06CC\u0627\u062A\u06CC \u0627\u0633\u062A.\n\n### \u06F1. \u062A\u0641\u0627\u0648\u062A \u0060async\u0060/\u0060await\u0060 \u0628\u0627 \u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC\n\n*   **\u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC (Parallelism):**\n    \u062F\u0631 \u0627\u06CC\u0646 \u062D\u0627\u0644\u062A\u060C \u06A9\u062F \u0631\u0648\u06CC \u0686\u0646\u062F\u06CC\u0646 \u0647\u0633\u062A\u0647 \u067E\u0631\u062F\u0627\u0632\u0646\u062F\u0647 (Core) \u0628\u0647 \u0635\u0648\u0631\u062A \u0647\u0645\u0632\u0645\u0627\u0646 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u06AF\u0631 \u06CC\u06A9 \u062A\u0627\u0631\u06AF\u062A \u0639\u0645\u0644\u06CC\u0627\u062A \u0637\u0648\u0644\u0627\u0646\u06CC \u0628\u0627\u0634\u062F (\u0645\u062B\u0644\u0627\u064B \u067E\u0631\u062F\u0627\u0632\u0634 \u0633\u0646\u06AF\u06CC\u0646 \u0631\u06CC\u0627\u0636\u06CC)\u060C \u0632\u0645\u0627\u0646 \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u062A\u0645\u0627\u0645 \u0634\u062F\u0646 \u0622\u0646 \u0627\u0632 \u0628\u06CC\u0646 \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 CPU\u0647\u0627 \u06A9\u0627\u0631 \u062F\u06CC\u06AF\u0631\u06CC \u0627\u0646\u062C\u0627\u0645 \u0646\u0645\u06CC\u200C\u062F\u0647\u0646\u062F. \u0627\u06CC\u0646 \u0631\u0648\u0634 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0628\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 \u0060Task.Run\u0060 \u06CC\u0627 \u06A9\u062A\u0627\u0628\u062E\u0627\u0646\u0647 \u0060Parallel\u0060 \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F.\n\n*   **\u0060async\u0060/\u0060await\u0060:**\n    \u0627\u06CC\u0646 \u0627\u0644\u06AF\u0648 \u0628\u0647 \u062C\u0627\u06CC \u0022\u0627\u062C\u0631\u0627\u06CC \u0647\u0645\u0632\u0645\u0627\u0646\u0022\u060C \u0627\u0632 **\u0022\u062A\u0648\u0642\u0641 \u0648 \u0627\u062F\u0627\u0645\u0647\u0022 (Cooperative Multitasking)** \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0648\u0642\u062A\u06CC \u06CC\u06A9 \u062A\u0627\u0628\u0639 \u0060async\u0060 \u062F\u0631 \u0646\u0642\u0637\u0647\u200C\u0627\u06CC \u06A9\u0647 \u0645\u0646\u062A\u0638\u0631 \u067E\u0627\u0633\u062E \u0634\u0628\u06A9\u0647 \u0627\u0633\u062A (\u0645\u062B\u0644\u0627\u064B \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP) \u0645\u062A\u0648\u0642\u0641 \u0645\u06CC\u200C\u0634\u0648\u062F (\u0060await\u0060)\u060C \u0641\u0631\u0622\u06CC\u0646\u062F \u0627\u0635\u0644\u06CC (Thread) **\u0646\u0645\u06CC\u200C\u0628\u0646\u062F\u062F** \u0648 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0633\u06CC\u0633\u062A\u0645 \u0639\u0627\u0645\u0644 \u06CC\u0627 \u0647\u0633\u062A\u0647 \u067E\u0631\u062F\u0627\u0632\u0646\u062F\u0647 \u06A9\u0627\u0631\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0631\u0627 \u0627\u0646\u062C\u0627\u0645 \u062F\u0647\u062F.\n    \n    **\u062A\u0641\u0627\u0648\u062A \u06A9\u0644\u06CC\u062F\u06CC:** \u062F\u0631 \u0060async\u0060/\u0060await\u0060\u060C \u06A9\u062F \u0628\u0647 \u0635\u0648\u0631\u062A \u062A\u0648\u0627\u0644\u06CC \u062E\u0637\u200C\u0628\u0647\u200C\u062E\u0637 \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0627\u0645\u0627 \u0627\u062C\u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u063A\u06CC\u0631\u0647\u0645\u0632\u0645\u0627\u0646 (Non-blocking) \u0627\u0633\u062A\u061B \u06CC\u0639\u0646\u06CC \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062A\u0627\u0628\u0639 \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u0627\u062F\u0627\u0645\u0647 \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u0632\u0645\u0627\u0646\u06CC \u06A9\u0647 \u067E\u0627\u0633\u062E \u0628\u0631\u06AF\u0631\u062F\u062F. \u062F\u0631 \u0645\u0642\u0627\u0628\u0644\u060C \u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC \u0686\u0646\u062F\u06CC\u0646 \u06A9\u062F \u0631\u0627 \u0647\u0645\u0632\u0645\u0627\u0646 \u0631\u0648\u06CC \u0647\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 \u067E\u062E\u0634 \u0645\u06CC\u200C\u06A9\u0646\u062F.\n\n#### \u0645\u062B\u0627\u0644 \u06A9\u0648\u062A\u0627\u0647 \u062F\u0631 C# (\u062A\u0641\u0627\u0648\u062A async \u0628\u0627 Parallel)\n\n\u0060\u0060\u0060csharp\nusing System;\nusing System.Threading.Tasks;\n\nclass Program\n{\n    static async Task Main()\n    {\n        // \u0633\u0646\u0627\u0631\u06CC\u0648: \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u067E\u0627\u0633\u062E HTTP (\u06A9\u0647 \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F \u0627\u0645\u0627 \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632\u06CC \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645)\n        \n        // \u0631\u0648\u0634 1: \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 async/await (\u062A\u0648\u0642\u0641 \u0648 \u0627\u062F\u0627\u0645\u0647)\n        // \u0627\u06CC\u0646 \u06A9\u062F \u0641\u0642\u0637 \u06CC\u06A9 Thread \u0631\u0627 \u0627\u0634\u063A\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 \u062D\u06CC\u0646 await\u060C Thread \u0622\u0632\u0627\u062F \u0627\u0633\u062A.\n        var taskAsync = Task.Run(() =\u003E \n        {\n            Console.WriteLine(\u0022\u0634\u0631\u0648\u0639 \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP...\u0022);\n            // \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632\u06CC \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u067E\u0627\u0633\u062E (\u0645\u062B\u0644\u0627\u064B 2 \u062B\u0627\u0646\u06CC\u0647)\n            await Task.Delay(2000); \n            Console.WriteLine(\u0022\u067E\u0627\u0633\u062E \u062F\u0631\u06CC\u0627\u0641\u062A \u0634\u062F.\u0022);\n        });\n\n        // \u0627\u06CC\u0646\u062C\u0627 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u0627\u062F\u0627\u0645\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u062F\u0631 \u062D\u0627\u0644\u06CC \u06A9\u0647 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u062F\u0631 \u062D\u0627\u0644 \u067E\u0631\u062F\u0627\u0632\u0634 \u0627\u0633\u062A.\n        Console.WriteLine(\u0022\u062F\u0631 \u062D\u0627\u0644 \u0627\u0646\u062A\u0638\u0627\u0631 \u067E\u0627\u0633\u062E...\u0022); \n        \n        // \u0631\u0648\u0634 2: \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 Parallel (\u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC \u0648\u0627\u0642\u0639\u06CC)\n        // \u0627\u06CC\u0646 \u06A9\u062F \u0633\u0639\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0627\u0631\u0647\u0627 \u0631\u0627 \u0631\u0648\u06CC \u0647\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 CPU \u0627\u0646\u062C\u0627\u0645 \u062F\u0647\u062F.\n        // \u0627\u06AF\u0631 \u062F\u0648 \u062A\u0627 Task Run \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u06CC\u0645\u060C \u0647\u0631 \u062F\u0648 \u0647\u0645\u0632\u0645\u0627\u0646 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.\n        var taskParallel = Task.Run(() =\u003E \n        {\n            Console.WriteLine(\u0022\u0634\u0631\u0648\u0639 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0645\u0648\u0627\u0632\u06CC...\u0022);\n            await Task.Delay(2000);\n            Console.WriteLine(\u0022\u067E\u0627\u0633\u062E \u062F\u0631\u06CC\u0627\u0641\u062A \u0634\u062F.\u0022);\n        });\n\n        // \u0627\u06AF\u0631 \u0627\u06CC\u0646\u062C\u0627 \u062F\u0648 \u062A\u0627 Task Run \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u06CC\u0645\u060C \u0647\u0631 \u062F\u0648 \u0647\u0645\u0632\u0645\u0627\u0646 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.\n        var taskParallel2 = Task.Run(() =\u003E \n        {\n            Console.WriteLine(\u0022\u0634\u0631\u0648\u0639 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0645\u0648\u0627\u0632\u06CC \u062F\u0648\u0645...\u0022);\n            await Task.Delay(2000);\n            Console.WriteLine(\u0022\u067E\u0627\u0633\u062E \u062F\u0631\u06CC\u0627\u0641\u062A \u0634\u062F.\u0022);\n        });\n\n        // \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u062A\u0645\u0627\u0645 \u0634\u062F\u0646 \u0647\u0631 \u062F\u0648\n        await taskAsync;\n        await taskParallel;\n        await taskParallel2;\n    }\n}\n\u0060\u0060\u0060\n\n### \u06F2. \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 CancellationToken \u0628\u0631\u0627\u06CC \u0644\u063A\u0648 \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP\n\n\u062F\u0631 \u0628\u0631\u0646\u0627\u0645\u0647\u200C\u0647\u0627\u06CC \u0645\u062F\u0631\u0646 (\u0645\u062B\u0644 ASP.NET Core)\u060C \u0627\u063A\u0644\u0628 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u06CC\u0645 \u06A9\u0647 \u06A9\u0627\u0631\u0628\u0631 \u062F\u0631\u062E\u0648\u0627\u0633\u062A\u06CC \u0631\u0627 \u0634\u0631\u0648\u0639 \u06A9\u0646\u062F \u0627\u0645\u0627 \u0642\u0628\u0644 \u0627\u0632 \u067E\u0627\u0633\u062E \u06AF\u0631\u0641\u062A\u0646\u060C \u062A\u0635\u0645\u06CC\u0645 \u0628\u06AF\u06CC\u0631\u062F \u0648 \u0622\u0646 \u0631\u0627 **\u0644\u063A\u0648** \u06A9\u0646\u062F (\u0645\u062B\u0644\u0627\u064B \u06A9\u0627\u0631\u0628\u0631 \u0635\u0641\u062D\u0647 \u0631\u0627 \u0628\u0633\u062A \u06CC\u0627 \u062A\u0627\u06CC\u0645\u0631 \u0627\u0646\u0642\u0636\u0627\u06CC \u0634\u062F).\n\n\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0627\u0632 \u0060CancellationToken\u0060 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u06CC\u0646 \u062A\u0648\u06A9\u0646 \u06CC\u06A9 \u0645\u06A9\u0627\u0646\u06CC\u0632\u0645 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0628\u0631\u0627\u06CC \u0627\u0631\u0633\u0627\u0644 \u0633\u06CC\u06AF\u0646\u0627\u0644 \u0022\u062A\u0648\u0642\u0641\u0022 \u0628\u0647 \u0639\u0645\u0644\u06CC\u0627\u062A\u200C\u0647\u0627\u06CC \u0628\u0644\u0648\u06A9\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A. \u0627\u06AF\u0631 \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP \u0642\u0628\u0644 \u0627\u0632 \u067E\u0627\u0633\u062E\u060C \u0633\u06CC\u06AF\u0646\u0627\u0644 \u062A\u0648\u0642\u0641 \u0631\u0627 \u062F\u0631\u06CC\u0627\u0641\u062A \u06A9\u0646\u062F\u060C \u0646\u0628\u0627\u06CC\u062F \u0645\u0646\u062A\u0638\u0631 \u0628\u0645\u0627\u0646\u062F \u0648 \u0628\u0627\u06CC\u062F \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u0628\u0627 \u062E\u0637\u0627\u06CC\u06CC \u06A9\u0647 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0644\u063A\u0648 \u0634\u062F\u0647 (\u0060OperationCanceledException\u0060) \u067E\u0627\u06CC\u0627\u0646 \u06CC\u0627\u0628\u062F.\n\n#### \u0645\u062B\u0627\u0644 \u06A9\u0648\u062A\u0627\u0647 \u062F\u0631 C# (\u0644\u063A\u0648 \u062F\u0631\u062E\u0648\u0627\u0633\u062A)\n\n\u0060\u0060\u0060csharp\nusing System;\nusing System.Threading;\nusing System.Threading.Tasks;\n\nclass Program\n{\n    static async Task Main()\n    {\n        // \u0627\u06CC\u062C\u0627\u062F \u06CC\u06A9 \u062A\u0648\u06A9\u0646 \u0644\u063A\u0648 \u0648 \u06CC\u06A9 \u0648\u0638\u06CC\u0641\u0647 \u0628\u0631\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A \u0622\u0646\n        var cts = new CancellationTokenSource();\n        var token = cts.Token;\n\n        // \u062A\u0627\u0628\u0639\u06CC \u06A9\u0647 \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP \u0631\u0627 \u0628\u0627 \u062F\u0631\u06CC\u0627\u0641\u062A \u0633\u06CC\u06AF\u0646\u0627\u0644 \u062A\u0648\u0642\u0641 \u0644\u063A\u0648 \u0645\u06CC\u200C\u06A9\u0646\u062F\n        async Task MakeRequestAsync(CancellationToken cancellationToken)\n        {\n            try\n            {\n                Console.WriteLine(\u0022\u062F\u0631\u062E\u0648\u0627\u0633\u062A \u062F\u0631 \u062D\u0627\u0644 \u0627\u0631\u0633\u0627\u0644...\u0022);\n                \n                // \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632\u06CC \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u067E\u0627\u0633\u062E (\u0645\u062B\u0644\u0627\u064B 5 \u062B\u0627\u0646\u06CC\u0647)\n                // \u0627\u06AF\u0631 \u062A\u0648\u06A9\u0646 \u062F\u0631 \u0627\u06CC\u0646 \u0645\u062F\u062A \u0633\u06CC\u06AF\u0646\u0627\u0644 \u062A\u0648\u0642\u0641 \u0628\u06AF\u06CC\u0631\u062F\u060C \u0627\u06CC\u0646\u062C\u0627 \u0645\u062A\u0648\u0642\u0641 \u0645\u06CC\u200C\u0634\u0648\u062F.\n                await Task.Delay(5000, cancellationToken); \n                \n                Console.WriteLine(\u0022\u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0627\u0646\u062C\u0627\u0645 \u0634\u062F.\u0022);\n            }\n            catch (OperationCanceledException ex)\n            {\n                // \u0627\u06AF\u0631 \u06A9\u0627\u0631\u0628\u0631 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0631\u0627 \u0644\u063A\u0648 \u06A9\u0631\u062F\u060C \u0627\u06CC\u0646 \u062E\u0637\u0627 \u0631\u062E \u0645\u06CC\u200C\u062F\u0647\u062F\n                Console.WriteLine($\u0022\u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0644\u063A\u0648 \u0634\u062F: {ex.Message}\u0022);\n            }\n        }\n\n        // \u0634\u0631\u0648\u0639 \u06CC\u06A9 \u062A\u0627\u0631\u06AF\u062A \u0628\u0631\u0627\u06CC \u0627\u0646\u062C\u0627\u0645 \u06A9\u0627\u0631\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u062F\u0631 \u062D\u06CC\u0646 \u0627\u0646\u062A\u0638\u0627\u0631\n        Task backgroundTask = Task.Run(() =\u003E \n        {\n            Thread.Sleep(3000); // \u0628\u0639\u062F \u0627\u0632 3 \u062B\u0627\u0646\u06CC\u0647\u060C \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0631\u0627 \u0644\u063A\u0648 \u06A9\u0646\n            cts.Cancel(); \n        });\n\n        // \u0627\u062C\u0631\u0627\u06CC \u062F\u0631\u062E\u0648\u0627\u0633\u062A HTTP \u0628\u0627 \u062A\u0648\u06A9\u0646 \u0644\u063A\u0648\n        await MakeRequestAsync(token);\n\n        // \u067E\u0627\u06CC\u0627\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\n        backgroundTask.Wait();\n    }\n}\n\u0060\u0060\u0060\n\n### \u062E\u0644\u0627\u0635\u0647 \u0646\u0647\u0627\u06CC\u06CC\n1.  **\u0060async\u0060/\u0060await\u0060** \u0628\u0647 \u0634\u0645\u0627 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u062F \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u062A\u0648\u0627\u0644\u06CC\u200C\u0628\u0646\u062F\u06CC \u0634\u062F\u0647 \u0628\u0646\u0648\u06CC\u0633\u06CC\u062F\u060C \u0627\u0645\u0627 \u0627\u062C\u0631\u0627 \u0622\u0646 \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u067E\u0633 \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u062F\u0631\u062E\u0648\u0627\u0633\u062A (\u0645\u062B\u0644\u0627\u064B HTTP) \u0627\u062F\u0627\u0645\u0647 \u067E\u06CC\u062F\u0627 \u06A9\u0646\u062F \u062A\u0627 \u0645\u0646\u0627\u0628\u0639 \u0633\u06CC\u0633\u062A\u0645 \u0622\u0632\u0627\u062F \u0634\u0648\u0646\u062F. \u0627\u06CC\u0646 \u0628\u0627 **\u0627\u062C\u0631\u0627\u06CC \u0645\u0648\u0627\u0632\u06CC** \u06A9\u0647 \u0686\u0646\u062F\u06CC\u0646 \u06A9\u062F \u0631\u0627 \u0647\u0645\u0632\u0645\u0627\u0646 \u0631\u0648\u06CC \u0647\u0633\u062A\u0647\u200C\u0647\u0627\u06CC CPU \u067E\u062E\u0634 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0633\u062A.\n2.  **\u0060CancellationToken\u0060** \u0627\u0628\u0632\u0627\u0631\u06CC \u0628\u0631\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644 \u062C\u0631\u06CC\u0627\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0647 \u062A\u0648\u0627\u0628\u0639 \u0628\u0644\u0648\u06A9\u0647 \u0634\u062F\u0647 (\u0645\u0627\u0646\u0646\u062F \u0060Task.Delay\u0060 \u06CC\u0627 \u062F\u0631\u062E\u0648\u0627\u0633\u062A\u200C\u0647\u0627\u06CC \u0634\u0628\u06A9\u0647) \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0642\u0628\u0644 \u0627\u0632 \u067E\u0627\u06CC\u0627\u0646\u060C \u0633\u06CC\u06AF\u0646\u0627\u0644 \u062A\u0648\u0642\u0641 \u0631\u0627 \u062F\u0631\u06CC\u0627\u0641\u062A \u06A9\u0646\u0646\u062F \u0648 \u0628\u062F\u0648\u0646 \u0627\u0646\u062A\u0638\u0627\u0631 \u0646\u0647\u0627\u06CC\u06CC\u060C \u0639\u0645\u0644\u06CC\u0627\u062A \u062E\u0648\u062F \u0631\u0627 \u0645\u062A\u0648\u0642\u0641 \u06A9\u0646\u0646\u062F.",
